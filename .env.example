# =============================================================
# Turtle Image Sketcher — configuration
# Copy this file to ".env" and edit the values there.
# (.env is private and never committed; this file is the public template.)
# =============================================================

# --- IMAGE SOURCE (required) ---
# Give EITHER a local file path OR a full URL. The script auto-detects
# which one you gave based on whether it starts with http:// or https://
#
# Local file example (relative to this folder, or an absolute path):
IMAGE_SOURCE=spiderman.png
#
# URL example (uncomment to use instead):
# IMAGE_SOURCE=https://example.com/images/spiderman.png

# --- SETUP WINDOW ---
# true: show a window to pick style, colors, detail and speed before drawing.
# false: use the values below straight away.
SHOW_SETUP=true

# --- STYLE ---
# auto (default): silhouette for two-tone images, sketch for pencil drawings,
#                 comic for everything else
# silhouette: solid shapes; lineart: edges as pen lines; color: flat colors;
# comic: color plus line art (best for anime); sketch: pencil scribble
MODE=auto

# Colors: original (the image's own colors), grayscale, or bw (black and white)
PALETTE=original

# Detail: low, medium or high. Higher looks closer to the original but takes longer to draw.
DETAIL=high

# Optional: exact number of colors for the color and comic styles (2-32).
# Leave as auto to use the DETAIL preset (low 8, medium 14, high 24).
COLORS=auto

# --- SPEED ---
# slow, normal, fast, instant, or custom (uses UPDATE_EVERY below).
# While drawing, press 1-4 to change speed and Space to pause.
SPEED=normal

# Only used when SPEED=custom: points drawn between screen refreshes.
UPDATE_EVERY=3

# --- IMAGE PROCESSING ---
# Height in pixels the image is resized to before tracing (width scales to match)
TARGET_HEIGHT=700

# Silhouette style only: brightness cutoff (0-255), or "auto" to pick it from the image.
# The subject is whichever side is opposite the background, so dark backgrounds work too.
THRESHOLD=auto

# Silhouette style only: smallest shape kept. Raise it to ignore specks.
MIN_CONTOUR_AREA=15

# --- WINDOW ---
# Window size in pixels, or auto for 85% of your screen.
WINDOW_WIDTH=auto
WINDOW_HEIGHT=auto

# How much of the window the drawing fills (0.1-1.0). It follows the window
# when you resize or maximize it.
DRAW_SCALE=0.95

# Pen thickness
PEN_SIZE=1

# --- COLORS ---
# Any turtle-recognized color name or hex code (e.g. "black", "#1a1a1a", "navy").
# PEN_COLOR is used by the silhouette and line art styles when PALETTE is grayscale or bw.
BACKGROUND_COLOR=white
PEN_COLOR=black

# --- OUTPUT ---
# Optional: save the final drawing as a PostScript (.eps) file when done.
# Leave blank to skip saving.
SAVE_OUTPUT_PATH=

# Automatically close the window this many seconds after drawing finishes
# (useful for unattended runs; it also skips the setup window). 0 keeps it open.
AUTO_CLOSE_AFTER_SECONDS=0
