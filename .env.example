# =============================================================
# Turtle Image Sketcher — configuration
# Copy this file to ".env" and edit the values there.
# (.env is private and never committed; this file is the public template.)
# =============================================================

# --- IMAGE SOURCE (required) ---
# Give EITHER a local file path OR a full URL. The script auto-detects
# which one you gave based on whether it starts with http:// or https://
#
# Local file example (relative to this folder, or an absolute path):
IMAGE_SOURCE=spiderman.png
#
# URL example (uncomment to use instead):
# IMAGE_SOURCE=https://example.com/images/spiderman.png

# --- DRAWING MODE ---
# auto (default): silhouette for two-tone images, comic for everything else
# silhouette: solid shapes; lineart: edges as pen lines;
# color: the image in a few flat colors; comic: color plus line art (best for anime)
MODE=auto

# Number of colors for the color and comic modes (2-32)
COLORS=12

# --- IMAGE PROCESSING ---
# Target height in pixels the image is resized to before tracing (width auto-scales)
TARGET_HEIGHT=700

# Silhouette mode only: brightness cutoff (0-255), or "auto" to pick it from the image.
# The subject is whichever side is opposite the background, so dark backgrounds work too.
THRESHOLD=auto

# Minimum shape area to keep. Raise this to ignore more small specks.
MIN_CONTOUR_AREA=15

# --- DRAWING / ANIMATION ---
# Scales the drawing size on the turtle canvas (1.0 = actual pixel size).
# It shrinks automatically if the drawing would not fit the window.
DRAW_SCALE=0.8

# Turtle window size (pixels)
WINDOW_WIDTH=800
WINDOW_HEIGHT=575

# Animation speed: ask (show a picker window), slow, normal, fast, instant,
# or custom (use PEN_SPEED and UPDATE_EVERY below).
# While drawing, press 1-4 to change speed and Space to pause.
SPEED=ask

# Only used when SPEED=custom.
# Turtle pen speed (0 = fastest/no animation, 1 = slowest, 10 = fast)
PEN_SPEED=3

# Only used when SPEED=custom.
# Points drawn between each screen refresh.
# Lower = smoother/slower "hand-drawn" animation. Higher = faster but jumpier.
UPDATE_EVERY=3

# Pen thickness
PEN_SIZE=1

# --- COLORS ---
# Any turtle-recognized color name or hex code (e.g. "black", "#1a1a1a", "navy").
# PEN_COLOR is used by the silhouette and lineart modes.
BACKGROUND_COLOR=white
PEN_COLOR=black

# --- OUTPUT ---
# Optional: save the final drawing as a PostScript (.eps) file when done.
# Leave blank to skip saving.
SAVE_OUTPUT_PATH=

# Automatically close the turtle window a few seconds after drawing finishes
# (useful for unattended runs). Set to 0 to keep window open until manually closed.
AUTO_CLOSE_AFTER_SECONDS=0
